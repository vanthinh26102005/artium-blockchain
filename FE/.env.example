# API
NEXT_PUBLIC_API_URL="http://localhost:8081/api"
NEXT_PUBLIC_ARTWORK_API_URL="http://localhost:8081/api/artwork"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# NextAuth
NEXTAUTH_SECRET="your-32-byte-or-longer-random-secret"
NEXTAUTH_URL="http://localhost:3000/"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Wallet checkout
NEXT_PUBLIC_PLATFORM_ETH_WALLET="0xYourPlatformWalletAddressHere"

# Wallet login / Sepolia
NEXT_PUBLIC_WEB3_CHAIN_ID="11155111"
NEXT_PUBLIC_WEB3_CHAIN_NAME="Sepolia"
NEXT_PUBLIC_WEB3_RPC_URL="https://your-sepolia-rpc-endpoint-here"

# Ethereum checkout / Sepolia
NEXT_PUBLIC_ETH_CHAIN_ID="11155111"
NEXT_PUBLIC_ETH_CHAIN_NAME="Sepolia"
NEXT_PUBLIC_ETH_RPC_URL="https://your-sepolia-rpc-endpoint-here"
NEXT_PUBLIC_ETH_BLOCK_EXPLORER_URL="https://sepolia.etherscan.io"
NEXT_PUBLIC_AUCTION_ESCROW_CONTRACT_ADDRESS="0xYourArtAuctionEscrowContractAddressHere"

# Seller auctions
# Defaults are 86400 seconds (24 hours) and 2592000 seconds (30 days).
NEXT_PUBLIC_SELLER_AUCTION_MIN_DURATION_SECONDS="86400"
NEXT_PUBLIC_SELLER_AUCTION_MAX_DURATION_SECONDS="2592000"
